    email: zhengjiewu39@gmail.com
repository-code: "https://github.com/zhengjiewu39-lab/Traditional-Chinese-Medicine-Pharmacy"
version: 3.0.0
date-released: 2026-09-26
license: MIT
keywords:
  - community pharmacy
  - essential medicines
  - supply chain resilience
  - equity
  - simulation
  - inventory allocation
  - heuristic
