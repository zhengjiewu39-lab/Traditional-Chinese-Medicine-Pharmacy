# Environment variables (copy to .env for local development)

NODE_ENV=development

# API
PORT=3002
# Frontend (Create React App) — must point at Express API
REACT_APP_API_BASE_URL=http://localhost:3002/api
CORS_ORIGIN=http://localhost:3000,http://localhost:3003
RATE_LIMIT_MAX=300

# Auth — required in production
TCM_JWT_SECRET=change-me-in-production
# TCM_USERS_JSON={"admin":{"password":"...","user":{...}}}

# Demo-only credentials (ignored when ALLOW_DEMO_AUTH=false)
ALLOW_DEMO_AUTH=true
TCM_ADMIN_PASSWORD=
TCM_PHARMACIST_PASSWORD=

# AI screening (semantic track). Production refuses AI_PROVIDER=mock.
# Unset or "rules" = hard-rule engine only.
# Prefer connecting a live model in the admin UI (AI治理中心 → 接入真实 AI).
# The UI stores the key in the gitignored data directory, not in this file.
AI_PROVIDER=mock
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=8000
# AI_MODE=rules|shadow|live  (production default: rules; never show mock as live)
AI_MODE=live
# DATA_MODE=demo|synthetic-study|pilot|production  (isolates case storage)
DATA_MODE=demo
# AI_DATA_RESIDENCY=on-prem|external
# AI_MODEL_PURPOSE=rx-screening
# AI_KILL_SWITCH=false
# PICKUP_TOKEN_TTL_MINUTES=30
# PICKUP_MAX_FAILURES=5

